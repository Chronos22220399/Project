{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "thread_num": 16,
    "use_ssl": false,
    "ssl": {
      "cert_file": "certs/server.crt",
      "key_file": "certs/server.key"
    }
  },
  "database": {
    "type": "sqlite3",
    "file": "./SuperMarketManagementSystem/datas/datas.sqlite3"
  },
  "log": {
    "level": "info",
    "file": "logs/server.log",
    "rotation_size_mb": 10,
    "max_files": 5
  },
  "auth": {
    "token_expire_minutes": 60,
    "secret_key": "your-secret-key"
  }
}
