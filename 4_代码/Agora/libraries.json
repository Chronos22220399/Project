{
  "fmt": {
    "url": "https://github.com/fmtlib/fmt.git",
    "options": {}
  },
  "sqlpp11": {
    "url": "https://github.com/rbock/sqlpp11.git",
    "options": {
      "BUILD_SQLITE3_CONNECTOR": "ON",
      "DEPENDENCY_CHECK": "OFF",
      "BUILD_TESTING": "OFF"
    }
  },
  "crow": {
    "url": "https://github.com/CrowCpp/Crow.git",
    "options": {
    "CROW_BUILD_EXAMPLES": "OFF",
    "CROW_BUILD_TESTS" : "OFF",
    "CROW_ENABLE_SSL": "ON",
    "CROW_ENABLE_COMPRESSION" : "ON"
    }
  }
}
